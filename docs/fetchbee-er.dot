// Graphviz DOT: Fetchbee 系统 ER 图（功能级）
// 说明：矩形=实体，菱形=功能关系；边上的 1/m/n 表示基数。

digraph fetchbee_er {
  graph [
    rankdir=TB,
    splines=ortho,
    nodesep=0.35,
    ranksep=0.45,
    fontname="Microsoft YaHei"
  ];
  node [shape=box, fontname="Microsoft YaHei"];
  edge [dir=none, labeldistance=1.3, labelangle=25, fontname="Microsoft YaHei"];

  // 实体
  user      [label="普通用户"];
  admin     [label="管理员"];
  account   [label="用户账户"];
  verify    [label="学生认证"];
  order     [label="订单"];
  rights    [label="维权申请"];
  notice    [label="通知"];
  announce  [label="公告"];

  // 功能关系（菱形）
  node [shape=diamond];

  // 用户账户管理
  reg           [label="用户注册"];
  login         [label="用户登录"];
  logout        [label="用户登出"];
  edit_profile  [label="修改个人信息"];
  change_pwd    [label="修改密码"];

  // 学生认证
  submit_verify [label="提交学生认证"];
  view_verify   [label="查看认证状态"];
  admin_view_verify   [label="查看待审核认证"];
  admin_review_verify [label="审核学生认证"];

  // 订单管理
  publish_order     [label="发布订单"];
  browse_orders     [label="浏览待接单订单"];
  take_order        [label="接单"];
  mark_delivered    [label="标记送达"];
  confirm_receive   [label="确认收货"];
  cancel_order      [label="取消订单"];
  view_order_status [label="查看订单状态"];

  // 维权管理
  submit_rights     [label="提交维权申请"];
  view_rights       [label="查看维权状态"];
  admin_view_rights [label="查看待审核维权"];
  admin_review_rights [label="审核维权申请"];
  admin_fund_flow   [label="处理资金流向"];

  // 通知系统
  view_unread     [label="查看未读通知"];
  view_all_notice [label="查看全部通知"];
  mark_notice_read [label="标记通知已读"];
  mark_all_read    [label="标记全部已读"];
  delete_notice    [label="删除通知"];

  // 公告模块
  view_latest_announce [label="查看最新公告"];
  admin_create_announce [label="创建公告"];
  admin_edit_announce   [label="修改公告"];
  admin_remove_announce [label="下架公告"];
  admin_list_announce   [label="查看所有公告"];

  // 数据统计
  stat_orders   [label="待审核订单数量统计"];
  stat_verify   [label="待审核认证数量统计"];
  stat_rights   [label="待审核维权数量统计"];
  stat_announce [label="公告数量统计"];

  // 关系与基数
  // 用户账户
  user    -> reg          [taillabel="1"]; account -> reg          [taillabel="1"];
  user    -> login        [taillabel="1"]; account -> login        [taillabel="1"];
  user    -> logout       [taillabel="1"]; account -> logout       [taillabel="1"];
  user    -> edit_profile [taillabel="1"]; account -> edit_profile [taillabel="1"];
  user    -> change_pwd   [taillabel="1"]; account -> change_pwd   [taillabel="1"];

  // 学生认证
  user  -> submit_verify [taillabel="1"]; verify -> submit_verify [taillabel="n"];
  user  -> view_verify   [taillabel="1"]; verify -> view_verify   [taillabel="n"];
  admin -> admin_view_verify   [taillabel="1"]; verify -> admin_view_verify   [taillabel="n"];
  admin -> admin_review_verify [taillabel="1"]; verify -> admin_review_verify [taillabel="n"];

  // 订单管理
  user  -> publish_order     [taillabel="1"]; order -> publish_order     [taillabel="n"];
  user  -> browse_orders     [taillabel="m"]; order -> browse_orders     [taillabel="n"];
  user  -> take_order        [taillabel="1"]; order -> take_order        [taillabel="n"];
  user  -> mark_delivered    [taillabel="1"]; order -> mark_delivered    [taillabel="n"];
  user  -> confirm_receive   [taillabel="1"]; order -> confirm_receive   [taillabel="n"];
  user  -> cancel_order      [taillabel="1"]; order -> cancel_order      [taillabel="n"];
  user  -> view_order_status [taillabel="m"]; order -> view_order_status [taillabel="n"];

  // 维权管理
  user  -> submit_rights [taillabel="1"]; rights -> submit_rights [taillabel="n"];
  user  -> view_rights   [taillabel="1"]; rights -> view_rights   [taillabel="n"];
  admin -> admin_view_rights   [taillabel="1"]; rights -> admin_view_rights   [taillabel="n"];
  admin -> admin_review_rights [taillabel="1"]; rights -> admin_review_rights [taillabel="n"];
  admin -> admin_fund_flow     [taillabel="1"]; rights -> admin_fund_flow     [taillabel="n"];

  // 通知系统
  user -> view_unread      [taillabel="1"]; notice -> view_unread      [taillabel="n"];
  user -> view_all_notice  [taillabel="1"]; notice -> view_all_notice  [taillabel="n"];
  user -> mark_notice_read [taillabel="1"]; notice -> mark_notice_read [taillabel="n"];
  user -> mark_all_read    [taillabel="1"]; notice -> mark_all_read    [taillabel="n"];
  user -> delete_notice    [taillabel="1"]; notice -> delete_notice    [taillabel="n"];

  // 公告模块
  user  -> view_latest_announce [taillabel="m"]; announce -> view_latest_announce [taillabel="n"];
  admin -> admin_create_announce [taillabel="1"]; announce -> admin_create_announce [taillabel="n"];
  admin -> admin_edit_announce   [taillabel="1"]; announce -> admin_edit_announce   [taillabel="n"];
  admin -> admin_remove_announce [taillabel="1"]; announce -> admin_remove_announce [taillabel="n"];
  admin -> admin_list_announce   [taillabel="1"]; announce -> admin_list_announce   [taillabel="n"];

  // 数据统计
  admin -> stat_orders   [taillabel="1"]; order    -> stat_orders   [taillabel="n"];
  admin -> stat_verify   [taillabel="1"]; verify   -> stat_verify   [taillabel="n"];
  admin -> stat_rights   [taillabel="1"]; rights   -> stat_rights   [taillabel="n"];
  admin -> stat_announce [taillabel="1"]; announce -> stat_announce [taillabel="n"];
}
